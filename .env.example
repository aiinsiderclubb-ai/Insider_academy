# Локальная разработка: не задавайте VITE_API_URL — Vite проксирует /api → localhost:3001
# Запуск: cd Insider_academy && npm run dev:all
# Проверка API: http://localhost:3001/api/health
#
# Если нужен продакшен-API с локального фронта (осторожно — пишет в боевую БД):
# VITE_API_URL=https://insider-academy.onrender.com/api

# Google Form — анкета и тест для набора AI Insider Accelerator
VITE_ACCELERATOR_APPLICATION_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform

# Academy (LMS) — myinsideracademy.com · маркетинг — insiderai.it.com
VITE_ACADEMY_URL=https://myinsideracademy.com
VITE_MAIN_SITE_URL=https://insiderai.it.com
VITE_TELEGRAM_COMMUNITY_URL=https://t.me/+gu0HQTZLad9lOWE0
# Invite link for Claude Pro giveaway entry (override only if needed)
# VITE_TELEGRAM_GIVEAWAY_CLAUDE_URL=https://t.me/+ECZbsUy0bD03NGFk
VITE_TELEGRAM_MANAGER_URL=https://t.me/vladyslavarcher
# Бот уведомлений Academy (без @): ссылка в футере и кабинете
# VITE_TELEGRAM_NOTIFY_BOT_USERNAME=InsiderAcademyNotifyBot
# или полная ссылка:
# VITE_TELEGRAM_NOTIFY_BOT_URL=https://t.me/YourNotifyBot

# Ссылка на пост розыгрыша в Telegram (для виджета на странице /giveaway/:slug)
# VITE_GIVEAWAY_TELEGRAM_URL=https://t.me/c/123/456
# Дедлайн розыгрыша Claude Pro (должен совпадать с GIVEAWAY_CLAUDE_ENDS_AT на API)
# VITE_GIVEAWAY_CLAUDE_ENDS_AT=2026-08-31T23:59:59+03:00

# OAuth (кнопки Google / Apple на /login и /register)
# Тот же Client ID должен быть на Render: GOOGLE_OAUTH_CLIENT_ID / APPLE_OAUTH_CLIENT_ID
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# VITE_APPLE_CLIENT_ID=com.aiinsider.academy.web
