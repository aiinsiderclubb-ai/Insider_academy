PORT=3001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Render (production) — задай в Dashboard, не коммить в git ──
# DATABASE_URL=          ← подставится автоматически из Postgres (render.yaml)
# PGSSL=true
# CORS_ORIGIN=https://myinsideracademy.com,https://www.myinsideracademy.com
# APP_URL=https://myinsideracademy.com
# APP_URL=https://insider-academy.onrender.com
# TRIBUTE_WEBHOOK_URL=https://insider-academy-api.onrender.com/api/webhooks/tribute
# ADMIN_PASSWORD=        ← свой пароль (не admin123!)
# TRIBUTE_API_KEY=
JWT_SECRET=change-this-in-production
ADMIN_PASSWORD=dev-admin-pass-1   # минимум 12 символов — короче сервер отвергнет
EDITOR_PASSWORD=editor123
MODERATOR_PASSWORD=moderator123
ADMIN_EMAIL=admin@example.com
# ADMIN_DIGEST=0  — отключить email-дайджест
ADMIN_JWT_SECRET=change-admin-secret-in-production

# PostgreSQL (optional — без DATABASE_URL используется SQLite)
# DATABASE_URL=postgresql://lms:lms@postgres:5432/lms
# PGSSL=false

# Storage: local | s3
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=eur

# LiqPay
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=

# Email (SMTP) — production: Render → Insider_academy API
# GoDaddy: smtpout.secureserver.net, port 465, SMTP_SECURE=true
# Brevo: smtp-relay.brevo.com, port 587
# Google Workspace: smtp.gmail.com, port 587, app password
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@myinsideracademy.com
# SMTP_PASS=
# EMAIL_FROM=AI Insider Academy <info@myinsideracademy.com>
# ADMIN_EMAIL=you@example.com

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Google Sheets / Drive (папка: https://drive.google.com/drive/folders/1JlbsIBxryW8dSemF4XSySdcVabqwxghh)
# Создайте Service Account в Google Cloud, включите Sheets API + Drive API,
# скачайте JSON-ключ и дайте email сервис-аккаунта доступ «Редактор» к папке на Drive.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_DRIVE_FOLDER_ID=1JlbsIBxryW8dSemF4XSySdcVabqwxghh
# GOOGLE_SHEETS_ENABLED=1

# OAuth — вход через Google / Apple (тот же Client ID, что и VITE_* на фронте)
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: https://myinsideracademy.com , http://localhost:5173
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Apple Developer → Identifiers → Services ID (+ Sign in with Apple)
# Return URLs: https://myinsideracademy.com/login
# APPLE_OAUTH_CLIENT_ID=com.aiinsider.academy.web

# Telegram Bot
# Telegram (@BotFather)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GIVEAWAY_CHANNEL=@aiinsiderclub
# TELEGRAM_BOT_USERNAME=InsiderAcademyNotifyBot
# TELEGRAM_BOT_SERVICE_URL=https://your-notify-bot.onrender.com
# TELEGRAM_BOT_SERVICE_SECRET=change-me-long-random-secret
# TELEGRAM_BOT_SERVICE_URL=http://localhost:3080
# TELEGRAM_BOT_SERVICE_SECRET=change-me-long-random-secret
# BOT_SERVICE_SECRET=change-me-long-random-secret

# Tribute (https://tribute.tg) — оплата через Telegram
TRIBUTE_API_KEY=
# ID магазина Tribute Shop (рекомендуется для сайта)
# TRIBUTE_SHOP_ID=
# Валюта: eur | rub | usd
TRIBUTE_CURRENCY=eur
# Публичный URL webhook в Tribute (на проде)
# TRIBUTE_WEBHOOK_URL=https://your-domain.com/api/webhooks/tribute
# TRIBUTE_WEBHOOK_SKIP_VERIFY=1  — только для локальной отладки
# ID цифрового продукта по умолчанию (если один продукт на все курсы)
# TRIBUTE_DEFAULT_PRODUCT_ID=65858
# Карта courseId -> productId для автовыдачи доступа по webhook
# TRIBUTE_PRODUCT_MAP={"ai-agency-builder":126606}

# ---- Продакшен-флаги ----
# ALLOW_DEMO_PURCHASE=1   # разрешить «тестовую оплату» в production (по умолчанию выключено)
# ALLOW_TEST_ACCOUNT=1    # разрешить вход в тестовый аккаунт в production (не включайте на живом проде)
