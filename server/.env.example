PORT=3001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Render (production) — задай в Dashboard, не коммить в git ──
# DATABASE_URL=          ← подставится автоматически из Postgres (render.yaml)
# PGSSL=true
# CORS_ORIGIN=https://insider-academy.onrender.com
# APP_URL=https://insider-academy.onrender.com
# TRIBUTE_WEBHOOK_URL=https://insider-academy-api.onrender.com/api/webhooks/tribute
# ADMIN_PASSWORD=        ← свой пароль (не admin123!)
# TRIBUTE_API_KEY=
JWT_SECRET=change-this-in-production
ADMIN_PASSWORD=admin123
EDITOR_PASSWORD=editor123
MODERATOR_PASSWORD=moderator123
ADMIN_EMAIL=admin@example.com
# ADMIN_DIGEST=0  — отключить email-дайджест
ADMIN_JWT_SECRET=change-admin-secret-in-production

# PostgreSQL (optional — без DATABASE_URL используется SQLite)
# DATABASE_URL=postgresql://lms:lms@postgres:5432/lms
# PGSSL=false

# Storage: local | s3
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=eur

# LiqPay
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=

# Email (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=AI Insider Academy <noreply@example.com>

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Telegram Bot
# TELEGRAM_BOT_TOKEN=

# Tribute (https://tribute.tg) — оплата через Telegram
TRIBUTE_API_KEY=
# ID магазина Tribute Shop (рекомендуется для сайта)
# TRIBUTE_SHOP_ID=
# Валюта: eur | rub | usd
TRIBUTE_CURRENCY=eur
# Публичный URL webhook в Tribute (на проде)
# TRIBUTE_WEBHOOK_URL=https://your-domain.com/api/webhooks/tribute
# TRIBUTE_WEBHOOK_SKIP_VERIFY=1  — только для локальной отладки
# ID цифрового продукта по умолчанию (если один продукт на все курсы)
# TRIBUTE_DEFAULT_PRODUCT_ID=65858
# Карта courseId -> productId для автовыдачи доступа по webhook
# TRIBUTE_PRODUCT_MAP={"ai-agency-builder":126606}
