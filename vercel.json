{
  "redirects": [
    { "source": "/", "destination": "/ru/", "permanent": true },
    { "source": "/packs/:path*", "destination": "/ru/packs/:path*", "permanent": true },
    { "source": "/memberships/:path*", "destination": "/ru/memberships/:path*", "permanent": true },
    { "source": "/blog/:path*", "destination": "/ru/blog/:path*", "permanent": true },
    { "source": "/events/:path*", "destination": "/ru/events/:path*", "permanent": true },
    { "source": "/giveaway/:path*", "destination": "/ru/giveaway/:path*", "permanent": true },
    { "source": "/learning-map", "destination": "/ru/learning-map", "permanent": true },
    { "source": "/calendar", "destination": "/ru/calendar", "permanent": true },
    { "source": "/oferta", "destination": "/ru/oferta", "permanent": true },
    { "source": "/privacy", "destination": "/ru/privacy", "permanent": true },
    { "source": "/refund", "destination": "/ru/refund", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://accounts.google.com https://appleid.cdn-apple.com https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://insider-academy.onrender.com https://accounts.google.com https://appleid.apple.com; frame-src https://accounts.google.com https://appleid.apple.com https://www.youtube.com https://player.vimeo.com https://t.me https://telegram.org; form-action 'self' https://www.liqpay.ua; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://insider-academy.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
