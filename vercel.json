{
  "build": {
    "env": {
      "VITE_API_URL": "https://insider-academy.onrender.com/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://insider-academy.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
