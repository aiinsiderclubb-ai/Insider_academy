{
  "name": "lms-platform",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "node scripts/generate-sitemap.js && vite build",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "parse:video-lessons": "node scripts/parse-video-lessons.cjs",
    "postinstall": "npm install --prefix server"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": "20.x"
  }
}
